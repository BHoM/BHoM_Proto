<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyVersion>10.0.0.0</AssemblyVersion>
    <Description>https://github.com/BHoM/BHoM_Proto</Description>
    <Authors>BHoM</Authors>
    <Copyright>Copyright © https://github.com/BHoM</Copyright>
    <RootNamespace>BH.Test.Proto</RootNamespace>
    <FileVersion>10.0.0.0</FileVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Grpc.Tools" Version="2.67.0" GeneratePathProperty="true" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit.Analyzers" Version="3.9.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>

  <!-- The reflection reference writer and reader the compiled ones of Protobuf_Engine are checked against. -->
  <ItemGroup>
    <Compile Include="..\..\..\Reference\*.cs" Link="Reference\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

  <!-- protoc and the google/protobuf/*.proto well-known types, used to check that the generated files compile. -->
  <ItemGroup>
    <None Include="$(PkgGrpc_Tools)\tools\windows_x64\protoc.exe" Link="protoc\protoc.exe" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(PkgGrpc_Tools)\build\native\include\google\protobuf\*.proto" Link="protoc\include\google\protobuf\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BHoM">
      <HintPath>$(ProgramData)\BHoM\Assemblies\BHoM.dll</HintPath>
    </Reference>
    <Reference Include="BHoM_Engine">
      <HintPath>$(ProgramData)\BHoM\Assemblies\BHoM_Engine.dll</HintPath>
    </Reference>
    <Reference Include="Google.Protobuf">
      <HintPath>$(ProgramData)\BHoM\Assemblies\Google.Protobuf.dll</HintPath>
    </Reference>
    <Reference Include="Protobuf_oM">
      <HintPath>$(ProgramData)\BHoM\Assemblies\Protobuf_oM.dll</HintPath>
    </Reference>
    <Reference Include="Protobuf_Engine">
      <HintPath>$(ProgramData)\BHoM\Assemblies\Protobuf_Engine.dll</HintPath>
    </Reference>
    <Reference Include="MongoDB.Bson">
      <HintPath>$(ProgramData)\BHoM\Assemblies\MongoDB.Bson.dll</HintPath>
    </Reference>
    <Reference Include="Serialiser_Engine">
      <HintPath>$(ProgramData)\BHoM\Assemblies\Serialiser_Engine.dll</HintPath>
    </Reference>
    <Reference Include="Test_Engine">
      <HintPath>$(ProgramData)\BHoM\Assemblies\Test_Engine.dll</HintPath>
    </Reference>
    <Reference Include="Test_oM">
      <HintPath>$(ProgramData)\BHoM\Assemblies\Test_oM.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
